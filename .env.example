# NeuroTrace Environment Configuration Example
# Copy to .env and customize as needed. Never commit .env with real credentials.

# Model Checkpoint Configuration
NEUROTRACE_MODEL_PATH=Flairbased_2/model_epoch_45 (1).pt
NEUROTRACE_DEVICE=cpu

# Data and Artifact Storage Directory
NEUROTRACE_DATA_DIR=data

# Gemma 4 Research Copilot API Configuration
# Required for agentic research commentary and tool orchestration
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_ID=gemini-2.5-flash

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

